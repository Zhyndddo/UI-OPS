NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — needed for Config -> Team invites, Config -> Delete User,
# and the notification digest cron route (app/api/**).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example

# Daily digest email (Config -> Notifications) — sent via SMTP through a
# real mailbox you already control, no domain ownership/DNS needed.
# Without SMTP_HOST/SMTP_USER/SMTP_PASS set, the digest still computes but
# doesn't actually send.
#
# Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_USER=your full address, SMTP_PASS= a 16-char
# App Password (Google Account -> Security -> 2-Step Verification -> App
# Passwords — needs 2FA turned on first; your real account password will
# NOT work here).
#
# Microsoft 365 / Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_USER=your full address, SMTP_PASS= an app
# password if MFA is on, otherwise your account password (Microsoft is
# phasing this out org by org — app password is the safer bet).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
DIGEST_FROM_EMAIL=an.thien@vieent.vn
# Shared secret Vercel Cron sends as a Bearer token — set this once you add
# the cron job in vercel.json, so the digest route can't be triggered by
# anyone who finds the URL.
CRON_SECRET=
