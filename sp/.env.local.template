# Copy this file to .env.local (same folder as package.json) and fill in
# real values. .env.local is already git-ignored by Next.js by default, so
# it won't get committed by accident.
#
# Where to find each value: Supabase dashboard → your project → Settings → API.

# --- Required — the app won't load without these ---

# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → Project API keys → "anon" / "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → Project API keys → "service_role"
# Keep this one private — it bypasses all row-level security. Only used
# server-side (API routes / server actions), never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional — only needed if you use the features that depend on them ---

# Used in links inside emails/notifications. For local testing this can
# just be http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed if YouTube-related features are wired up for you
YOUTUBE_API_KEY=

# Only needed for outgoing email (digests, notifications). Leave all of
# these blank/unset for local testing — the app is written to skip sending
# and just compute silently when SMTP isn't configured, so you won't
# accidentally email real people while testing.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
DIGEST_FROM_EMAIL=

# Only needed if you have a scheduled/cron endpoint guarded by a shared
# secret. Leave blank for local testing unless you're specifically testing
# that endpoint.
CRON_SECRET=
